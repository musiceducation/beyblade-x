# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only: room create / referee writes (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# HMAC secret for referee session tokens
ROOM_TOKEN_SECRET=change-me-to-a-long-random-string

# Legacy single-event portal (?legacy=1) — optional
NEXT_PUBLIC_EVENT_SLUG=mie-mie-2026
